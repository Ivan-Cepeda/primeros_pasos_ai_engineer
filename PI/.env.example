# ---------------------------------------------------------------------------
# Copia este archivo a ".env" y completa la clave del proveedor que uses.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / macOS)
#
# El archivo .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Proveedor a usar: "openai" (el que pide la consigna) o "gemini".
LLM_PROVIDER=openai

# --- OpenAI -----------------------------------------------------------------
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (alternativa con capa gratuita) ---------------------------
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
