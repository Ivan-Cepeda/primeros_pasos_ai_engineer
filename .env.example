# ---------------------------------------------------------------------------
# Copia este archivo a ".env" y completa SOLO las claves que vayas a usar.
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows CMD)
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ---------------------------------------------------------------------------

# Proveedor por defecto para todos los ejercicios: "openai" o "gemini".
# Se puede sobreescribir por ejecucion:  python 01_primer_llamado.py --provider gemini
LLM_PROVIDER=gemini

# --- OpenAI -----------------------------------------------------------------
# Obtene tu clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ----------------------------------------------------------
# Obtene tu clave (tiene capa gratuita) en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Opcional ---------------------------------------------------------------
# Si usas un proxy, Azure OpenAI, OpenRouter, Ollama, etc., podes forzar la URL:
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
